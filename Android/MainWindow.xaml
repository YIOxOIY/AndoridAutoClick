<Window x:Class="ScreenMirror.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安卓调试" Height="980" Width="540"
		ResizeMode="NoResize"
		>

	<Grid>
		<Grid.Background>
			<ImageBrush/>
		</Grid.Background>
		<Image x:Name="screenImage" 
       Stretch="UniformToFill"
			RenderOptions.BitmapScalingMode="HighQuality"
       StretchDirection="Both"
			MouseLeftButtonDown="Image_MouseLeftButtonDown"
			MouseLeftButtonUp ="Image_MouseLeftButtonUp">
		</Image>
		<Label x:Name="tip" Content="" HorizontalAlignment="Center" Margin="0,26,0,0" VerticalAlignment="Top" Width="260" Height="28" TextBlock.TextAlignment="Center" Foreground="#FFFF4C4C"/>
		<Button x:Name="record"  Click="ActionButton_Click" HorizontalAlignment="Left"  VerticalAlignment="Top" Height="30" Width="30" BorderBrush="{x:Null}" Foreground="{x:Null}" >
			<Button.Background>
				<ImageBrush ImageSource="/Resources/start.png" Stretch="Fill"/>
			</Button.Background>
		</Button>
		<Button x:Name="file"  Click="File_Click" HorizontalAlignment="Left"  VerticalAlignment="Top" Height="30" Width="30" BorderBrush="{x:Null}" Foreground="{x:Null}" Margin="0,30,0,0" >

			<Button.Background>
				<ImageBrush ImageSource="/Resources/file.png" Stretch="Fill"/>
			</Button.Background>
		</Button>

		<Button x:Name="stop"  Click="Stop_Click" HorizontalAlignment="Right"  VerticalAlignment="Top" Height="30" Width="30" BorderBrush="{x:Null}" Foreground="{x:Null}" Margin="0,45,10,0"   >
			<Button.Background>
				<ImageBrush ImageSource="/Resources/stop_1.png" Stretch="Fill"/>
			</Button.Background>
		</Button>
		<Button x:Name="play"  Click="Play_Click" HorizontalAlignment="Right"  VerticalAlignment="Top" Height="30" Width="30" BorderBrush="{x:Null}" Foreground="{x:Null}" Margin="0,10,10,0"   >
			<Button.Background>
				<ImageBrush ImageSource="/Resources/play.png" Stretch="Fill"/>
			</Button.Background>
		</Button>
	</Grid>
</Window>